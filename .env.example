# Copy this file to ".env" and fill in the values.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Path to the Google service-account key (JSON), relative to this folder
GOOGLE_KEY_FILE=google-key.json

# Link to the Google Sheet (or just its ID)
SPREADSHEET=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXX/edit

# Time zone for schedules, e.g. Europe/Moscow, Asia/Tokyo, Asia/Bangkok
TIMEZONE=UTC

# How often to check the sheet for notifications, in minutes
POLL_MINUTES=5
